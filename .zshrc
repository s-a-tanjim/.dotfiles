# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="powerlevel10k/powerlevel10k"
HIST_STAMPS="mm/dd/yyyy"
ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE="fg=cyan"

plugins=(git tmux zsh-autosuggestions zsh-syntax-highlighting zsh-fzf-history-search)

if [ -x "$(command -v aws)" ]; then
  plugins+=(aws)
  SHOW_AWS_PROMPT=false
fi
if [ -x "$(command -v kubectl)" ]; then
  plugins+=(kubectl)
fi

# nvm: eager loading costs ~600ms per shell, so load it on first use of
# nvm/node/npm/npx/pnpm/yarn/corepack.
# ponytail: node is not on PATH until one of those runs in the shell; add
# globally installed CLIs to `zstyle ':omz:plugins:nvm' lazy-cmd ...` if needed.
export NVM_DIR="$HOME/.nvm"
if [ -s "$NVM_DIR/nvm.sh" ]; then
  zstyle ':omz:plugins:nvm' lazy yes
  plugins+=(nvm)
fi

source $ZSH/oh-my-zsh.sh

# User configuration
export DOTFILES_DIR=${${(%):-%x}:A:h}
export EDITOR=nvim
export GPG_TTY=$(tty)
export PATH="$HOME/.opencode/bin:$PATH:/opt/nvim/bin"
[ -f "$HOME/.local/bin/env" ] && . "$HOME/.local/bin/env"

[[ ! -f ~/.bash_aliases ]] || source ~/.bash_aliases
[[ ! -f ~/.bash_functions ]] || source ~/.bash_functions

# Use the same path for loading and wizard integration, including symlinked dotfiles.
typeset -g POWERLEVEL9K_CONFIG_FILE="$DOTFILES_DIR/.p10k.zsh"
[[ ! -f $POWERLEVEL9K_CONFIG_FILE ]] || source "$POWERLEVEL9K_CONFIG_FILE"

# Keep custom settings outside the file regenerated by `p10k configure`.
typeset -g POWERLEVEL9K_TRANSIENT_PROMPT=same-dir
typeset -ga POWERLEVEL9K_KUBECONTEXT_CLASSES=('*prod*' PROD '*' DEFAULT)
typeset -g POWERLEVEL9K_KUBECONTEXT_PROD_FOREGROUND=196
typeset -g POWERLEVEL9K_KUBECONTEXT_PROD_VISUAL_IDENTIFIER_EXPANSION='PROD'
POWERLEVEL9K_KUBECONTEXT_SHOW_ON_COMMAND+='|kb|kctx|kns'
typeset -ga POWERLEVEL9K_AWS_CLASSES=('*prod*' PROD '*' DEFAULT)
typeset -g POWERLEVEL9K_AWS_PROD_FOREGROUND=196
typeset -g POWERLEVEL9K_AWS_PROD_VISUAL_IDENTIFIER_EXPANSION='PROD'
POWERLEVEL9K_AWS_SHOW_ON_COMMAND+='|awsprofile|tf'

# Terraform autocompletion (bash-style, hence bashcompinit)
if command -v terraform >/dev/null 2>&1; then
  autoload -U +X bashcompinit && bashcompinit
  complete -o nospace -C "$(command -v terraform)" terraform
fi

# Machine-specific paths, aliases and prompt overrides. Keep this file outside Git.
[[ ! -r ~/.zshrc.local ]] || source ~/.zshrc.local
